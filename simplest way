#a,b are parameters 

def calculate(a, b, operator):

#def = define a function 
#small reusable machine: you give it some information, it does a task, and it can give you a result.

    if operator == "+":
        return a + b
#return → sends the answer back
    elif operator == "-":
        return a - b
    elif operator == "*":
        return a * b
    elif operator == "/":
        return a / b

print(calculate(10, 5, "+"))


